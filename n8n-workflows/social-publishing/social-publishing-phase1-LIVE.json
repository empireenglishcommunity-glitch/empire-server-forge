  {
   "parameters": {
    "jsCode": "// Only act on video files; ignore the sibling metadata.json and anything else.\nconst f = $json;\nconst name = (f.name || '').toLowerCase();\nconst isVideo = /\\.(mp4|mov|mkv|webm)$/.test(name);\nif (!isVideo) { return []; }\nconst folderName = (f.parentFolderName || f.folderName || f.parents_folder_name || '').trim();\nlet brand_origin, destinations;\nif (folderName === '01-EEC-only') {\n  brand_origin = 'EEC';\n  destinations = [ {brand:'EEC', platform:'youtube'}, {brand:'EEC', platform:'instagram'} ];\n} else if (folderName === '02-EEC-and-MACAL') {\n  brand_origin = 'EEC';\n  destinations = [ {brand:'EEC', platform:'youtube'}, {brand:'EEC', platform:'instagram'}, {brand:'MACAL', platform:'instagram', staggered:true} ];\n} else if (folderName === '03-MACAL-only') {\n  brand_origin = 'MACAL';\n  destinations = [ {brand:'MACAL', platform:'instagram'} ];\n} else {\n  throw new Error('Unrecognized routing folder: ' + folderName + ' - refusing to publish.');\n}\nreturn [ { json: { file_id: f.id, file_name: f.name, folder: folderName, brand_origin, destinations } } ];"
   },
   "id": "3c98a8d4-905f-45d4-ad29-b869f046e323",
   "name": "Classify (folder \u2192 brand + destinations)",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    -976,
    144
   ]
  },
  {
   "parameters": {
    "jsCode": "const { brand_origin, destinations } = $json;\nif (brand_origin === 'MACAL' && destinations.some(d => d.brand === 'EEC')) {\n  throw new Error('BLOCKED: MACAL-origin content resolved an EEC destination. Aborting entire job.');\n}\nif (!Array.isArray(destinations) || destinations.length === 0) {\n  throw new Error('No destinations resolved - aborting.');\n}\nreturn [ { json: $json } ];"
   },
